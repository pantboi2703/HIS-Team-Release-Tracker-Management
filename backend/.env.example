# Copy to .env on the server and fill in. Never commit the real .env.

# Existing on-premise mongod. Use a dedicated app user scoped to readWrite on
# the rtt database only — see DEPLOYMENT.md for the createUser command.
MONGO_URI=mongodb://rtt_app:CHANGE_ME@127.0.0.1:27017/rtt?authSource=rtt
MONGO_DB=rtt

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Hospital LAN only. Comma-separated origins the browser may call from.
CORS_ORIGINS=http://localhost:5173

# Set true only when the app is served over HTTPS; it marks the refresh cookie
# Secure, which a browser will silently drop on plain HTTP.
COOKIE_SECURE=false

# Raw uploaded workbooks are kept here so any import bug is replayable.
UPLOAD_DIR=/var/lib/rtt/uploads
